    },
    "fieldPath": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "fix": {
      "$ref": "#/$defs/DiagnosticFix"
    },
    "graphPath": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "type": "string"
    }
